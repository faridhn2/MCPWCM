# Public HTTPS origin of this service. Do not include a trailing slash.
PUBLIC_BASE_URL=https://mcp.your-domain.example
HOST=0.0.0.0
PORT=3000
DATABASE_PATH=./data/service.db

# Generate with:
# node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
CREDENTIAL_ENCRYPTION_KEY=replace-with-a-32-byte-base64-key

# Development only. Keep false in production to prevent server-side request forgery.
ALLOW_PRIVATE_WOO_HOSTS=false
ACCESS_TOKEN_TTL_SECONDS=3600
REFRESH_TOKEN_TTL_SECONDS=2592000
