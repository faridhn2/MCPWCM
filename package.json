{
  "name": "woocommerce-insights-mcp",
  "version": "0.1.0",
  "private": true,
  "description": "Multi-tenant WooCommerce analytics MCP server for ChatGPT and Claude",
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "test": "tsc -p tsconfig.json && node --test --test-concurrency=1 \"dist/tests/*.test.js\"",
    "check": "npm run build && npm test"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.30.0",
    "express": "5.1.0",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@types/express": "5.0.3",
    "@types/node": "22.18.0",
    "tsx": "4.20.5",
    "typescript": "5.9.2"
  }
}
